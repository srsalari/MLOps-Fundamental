          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Business metric: predictions per second by result",
      "description": "churn_predictions_total comes from our own code (session 8), not from the library.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          },
          "expr": "sum by (churn) (rate(churn_predictions_total{job=\"churn-api\"}[1m]))",
          "legendFormat": "churn={{churn}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Model time: p95 of predict_proba",
      "description": "Only the model call, without the web framework.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(churn_predict_seconds_bucket{job=\"churn-api\"}[1m])))",
          "legendFormat": "p95 model",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
