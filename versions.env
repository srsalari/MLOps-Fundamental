# MLOps Fundamentals On-Prem — pinned lab versions (frozen 2026-10-08)
# Every version below was released at least 2 weeks before the freeze date.
# Change versions ONLY here, then rebuild the offline bundle.

PYTHON_VERSION=3.12
UV_VERSION=0.12.15

# Kubernetes toolchain
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
KUBECTL_VERSION=v1.36.4
HELM_VERSION=v4.2.4

# Security / supply chain
TRIVY_VERSION=0.74.0
SYFT_VERSION=1.51.1

# VM baseline (session 10)
MULTIPASS_VERSION=1.16.4
UBUNTU_VM_RELEASE=24.04

# Container images (lab services)
